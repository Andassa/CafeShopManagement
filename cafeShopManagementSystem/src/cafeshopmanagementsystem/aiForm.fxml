<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="878.0" stylesheets="@mainFormDesign.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafeshopmanagementsystem.aiFormController">
   <children>
      <AnchorPane prefHeight="290.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="322.0" AnchorPane.topAnchor="14.0">
         <styleClass>
            <String fx:value="white-bg" />
            <String fx:value="radius" />
            <String fx:value="shadow" />
         </styleClass>
         <children>
            <Label graphicTextGap="8.0" layoutX="16.0" layoutY="12.0" styleClass="section-title" text="Prévisions de stock">
               <graphic>
                  <FontAwesomeIcon fill="#412D15" glyphName="LINE_CHART" size="1.2em" />
               </graphic>
            </Label>
            <Label layoutX="16.0" layoutY="36.0" styleClass="section-subtitle" text="Lissage de Holt-Winters sur 6 semaines, stock de sécurité à 95 %" />
            <TableView fx:id="ai_stockTable" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="62.0">
