                  <TableColumn fx:id="ai_col_rupture" prefWidth="110.0" text="Rupture" />
                  <TableColumn fx:id="ai_col_commande" prefWidth="100.0" text="À commander" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="290.0" prefWidth="294.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
         <styleClass>
            <String fx:value="white-bg" />
            <String fx:value="radius" />
            <String fx:value="shadow" />
         </styleClass>
         <children>
            <Label graphicTextGap="8.0" layoutX="16.0" layoutY="12.0" styleClass="section-title" text="Analyse du jour">
