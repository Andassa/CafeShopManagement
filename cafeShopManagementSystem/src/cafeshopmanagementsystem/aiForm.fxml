                  <FontAwesomeIcon fill="#412D15" glyphName="BELL" size="1.2em" />
               </graphic>
            </Label>
            <Label layoutX="16.0" layoutY="36.0" styleClass="section-subtitle" text="Tendances et anomalies détectées" />
            <ListView fx:id="ai_alertList" styleClass="insight-list" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="62.0" />
         </children>
      </AnchorPane>
      <AnchorPane AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="318.0">
         <styleClass>
            <String fx:value="white-bg" />
            <String fx:value="radius" />
            <String fx:value="shadow" />
         </styleClass>
         <children>
            <Label graphicTextGap="8.0" layoutX="16.0" layoutY="12.0" styleClass="section-title" text="Assistant IA">
               <graphic>
                  <FontAwesomeIcon fill="#412D15" glyphName="COMMENTS" size="1.2em" />
               </graphic>
            </Label>
            <Label fx:id="ai_status" layoutX="140.0" layoutY="15.0" styleClass="section-subtitle" text="" AnchorPane.leftAnchor="140.0" AnchorPane.rightAnchor="16.0" />
