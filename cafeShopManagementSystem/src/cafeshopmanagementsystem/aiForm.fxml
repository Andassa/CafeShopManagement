            <Button fx:id="ai_askBtn" mnemonicParsing="false" onAction="#demander" prefHeight="34.0" prefWidth="120.0" styleClass="btn" text="Demander" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="44.0" />
            <TextArea fx:id="ai_answer" editable="false" styleClass="answer-area" wrapText="true" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="90.0" prefWidth="380.0" />
            <TableView fx:id="ai_resultTable" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="410.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="90.0">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </AnchorPane>
   </children>
