# Copier ce fichier en .env puis adapter les valeurs.
# Lu par docker compose et par l'application (variables d'environnement).

DB_ROOT_PASSWORD=change-me-root
DB_USER=cafe
DB_PASSWORD=change-me
DB_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/cafe?useSSL=false

# Assistant IA (optionnel). Fournisseur compatible avec l'API OpenAI.
# Groq (gratuit) : clé sur https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# Google Gemini (gratuit) : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
# Ollama en local (gratuit, sans clé) : AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.2
